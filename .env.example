# Copy this file to ".env" for local development (npm run dev).
# On Vercel, add the same variables under Project Settings -> Environment Variables.

# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
# Recommended: service role key (Supabase -> Project Settings -> API). Keep it secret!
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively the anon key works if you enable the optional policies in supabase/schema.sql
# SUPABASE_ANON_KEY=

# --- Arnemie's dashboard (required for /admin.html) ---
ADMIN_PASSWORD=change-me

# --- Optional schedule settings ---
MEETING_LOCATION=Faculty Office
TIMEZONE=Asia/Manila
# Last date students can book (YYYY-MM-DD). Defaults to December 10 of the current year.
BOOKING_END_DATE=2026-12-10
