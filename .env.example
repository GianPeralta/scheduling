# Copy this file to ".env" for local development (npm run dev).
# On Vercel, add the same variables under Project Settings -> Environment Variables.

# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
# Recommended: service role key (Supabase -> Project Settings -> API). Keep it secret!
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively the anon key works if you enable the optional policies in supabase/schema.sql
# SUPABASE_ANON_KEY=

# --- Teacher dashboard (required for /admin.html) ---
ADMIN_PASSWORD=change-me

# --- Optional customisation ---
TEACHER_NAME=Your Name
MEETING_TITLE=Student Consultation
MEETING_LOCATION=Faculty Office, Room 204
TIMEZONE=Asia/Manila
# Slots run from START_HOUR to END_HOUR (24h clock), one hour each
START_HOUR=9
END_HOUR=17
# Hours with no slot, comma separated (12 = 12:00-1:00 PM lunch). Leave empty for none.
BREAK_HOURS=12
# Days you accept bookings: 0=Sun 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat
WORKING_DAYS=1,2,3,4,5
# How many days ahead students can book
MAX_DAYS_AHEAD=30
