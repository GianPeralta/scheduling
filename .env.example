# Copy this file to ".env" for local development (npm run dev).
# On Vercel, add the same variables under Project Settings -> Environment Variables.

# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
# Required: service role key (Supabase -> Project Settings -> API). Keep it secret!
# (Student accounts are stored in tables that only the service role key can access.)
SUPABASE_SERVICE_ROLE_KEY=

# --- Arnemie's dashboard (required for /admin.html) ---
ADMIN_PASSWORD=change-me

# --- Student accounts (required) ---
# Only emails ending with these domains can register (comma-separated, subdomains allowed)
ALLOWED_EMAIL_DOMAINS=youruniversity.edu.ph
# Long random string used to sign login sessions and hash codes (min. 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Max upcoming consultations one student may hold at once (0 = unlimited)
MAX_ACTIVE_BOOKINGS_PER_STUDENT=2
# How long a student stays logged in (days)
SESSION_DAYS=7

# --- SMTP for sending verification codes (required) ---
# Gmail:      smtp.gmail.com, port 465 or 587, user = your Gmail, pass = a 16-char App Password
# Outlook/365: smtp.office365.com, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Sender shown to students (must be allowed by your SMTP account)
SMTP_FROM="Arnemie Gayyed Consultations <you@gmail.com>"

# --- Optional schedule settings ---
TEACHER_EMAIL=nemie07gayyed@gmail.com
MEETING_LOCATION=Faculty Office
TIMEZONE=Asia/Manila
# Last date students can book (YYYY-MM-DD). Defaults to November 30 of the current year.
BOOKING_END_DATE=2026-11-30
# Minutes before a scheduled appointment to send an automated email reminder to the student
STUDENT_REMINDER_MINUTES_BEFORE=60
